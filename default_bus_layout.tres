[gd_resource type="AudioBusLayout" format=3]

; 오디오 버스 분리: Master / SFX(효과음) / Ambience(환경음).
; Godot은 res://default_bus_layout.tres를 자동 로드 — project.godot 키 불필요.

[resource]
bus/0/name = &"Master"
bus/0/solo = false
bus/0/mute = false
bus/0/bypass_fx = false
bus/0/volume_db = 0.0
bus/0/send = &""
bus/1/name = &"SFX"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = -3.0
bus/1/send = &"Master"
bus/2/name = &"Ambience"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = -8.0
bus/2/send = &"Master"
