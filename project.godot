; Cozy Vale — Godot 4.7.1 stable (Forward+, 셀 셰이딩)
; DESIGN.md 11.5 기준 고정 버전.

config_version=5

[application]

config/name="Cozy Vale"
run/main_scene="res://world/world.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

InputSetup="*res://autoload/input_setup.gd"
GameData="*res://autoload/game_data.gd"
GameClock="*res://autoload/game_clock.gd"
SaveManager="*res://autoload/save_manager.gd"
Sfx="*res://autoload/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"
camera/exposure/multiplier=1.0
